# Servidor
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Autenticação (troque em produção: use pelo menos 32 caracteres aleatórios)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=financas
DB_PASSWORD=
DB_NAME=financas
DB_POOL_LIMIT=10

# Seed de demonstração
SEED_EMAIL=demo@financas.dev
SEED_PASSWORD=demo12345

# Obrigatórios em produção. Proxy deve remover headers encaminhados do cliente.
PUBLIC_ORIGIN=https://api.example.com
TRUSTED_PROXIES=
# Ativar depois no serviço, sem versionar o valor real.
SENTRY_DSN=
APP_RELEASE=

# Docker Compose exige senha própria, além de JWT_SECRET e DB_PASSWORD.
MYSQL_ROOT_PASSWORD=
