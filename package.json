{
  "name": "api-financas",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de finanças pessoais com Node.js, Express, MySQL e JWT",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test --test-reporter=spec",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "keywords": [
    "api",
    "rest",
    "express",
    "mysql",
    "jwt",
    "financas"
  ],
  "author": "Leonardo Fernandes Carrilho",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
